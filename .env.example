# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Local models (default) ───────────────────────────────────────────────
# Agents run on your local Ollama daemon. No key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Hosted models (optional) ─────────────────────────────────────────────
# Only needed if you pick a hosted model in the agent roster.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# ── Cross-device session sync (optional) ─────────────────────────────────
# Without these the app stores sessions in the browser only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Encrypting the API keys your users bring (required when hosting) ─────
# AES-256-GCM key for credentials at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this makes every stored key unreadable — back it up.
ENCRYPTION_KEY=

# ── Protecting a shared deployment (recommended if not local-only) ───────
# When set, /api/ai/* requires this token. Leave empty for local use.
AICOLLAB_ACCESS_TOKEN=

# ── Optional analytics ───────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:4028
