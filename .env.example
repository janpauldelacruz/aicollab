# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Local models (default) ───────────────────────────────────────────────
# Agents run on your local Ollama daemon. No key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window per request (tokens). 8192 fits a session prompt; lower it to
# 4096 on GPUs with less than 8 GB, raise it if a 14B+ model has room to spare.
OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model loaded between turns.
OLLAMA_KEEP_ALIVE=30m

# ── Free hosted models (optional) ────────────────────────────────────────
# Each free key below unlocks that provider's models. Set at least one (Groq is
# the quickest to get) on a hosted deployment with no Ollama, or nothing can
# run. Users can also add their own keys on the API Keys page — those are used
# first, so one heavy user does not exhaust your free quota for everyone.
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
HF_TOKEN=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
POLLINATIONS_API_KEY=

# ── Paid hosted models (optional) ────────────────────────────────────────
# Only needed if you pick a hosted model in the agent roster.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=            # also unlocks the free Gemini models
PERPLEXITY_API_KEY=

# ── Cross-device session sync (optional) ─────────────────────────────────
# Without these the app stores sessions in the browser only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Encrypting the API keys your users bring (required when hosting) ─────
# AES-256-GCM key for credentials at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this makes every stored key unreadable — back it up.
ENCRYPTION_KEY=

# ── Protecting a shared deployment (recommended if not local-only) ───────
# When set, /api/ai/* requires this token. Leave empty for local use.
AICOLLAB_ACCESS_TOKEN=

# ── Optional analytics ───────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:4028
